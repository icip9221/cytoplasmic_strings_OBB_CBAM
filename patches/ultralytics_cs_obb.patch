new file mode 100644
index 0000000..0cd0b0d
--- /dev/null
+++ b/ultralytics/nn/modules/cbam.py
@@ -0,0 +1,33 @@
+"""Compatibility CBAM module for the CS-OBB publication model."""
+
+import torch
+import torch.nn as nn
+
+from ultralytics.nn.modules.conv import SpatialAttention
+
+
+class ChannelAttention(nn.Module):
+    """Historical ChannelAttention used by the paper CBAM checkpoint."""
+
+    def __init__(self, channels: int) -> None:
+        super().__init__()
+        self.pool = nn.AdaptiveAvgPool2d(1)
+        self.fc = nn.Conv2d(channels, channels, 1, 1, 0, bias=True)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return x * torch.sigmoid(self.fc(self.pool(x)))
+
+
+class CBAM(nn.Module):
+    """Historical CBAM block used immediately before P5 feature fusion."""
+
+    def __init__(self, c1: int) -> None:
+        super().__init__()
+        self.channel_attention = ChannelAttention(c1)
+        self.spatial_attention = SpatialAttention()
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return self.spatial_attention(self.channel_attention(x))
+
+
+__all__ = ["CBAM", "ChannelAttention", "SpatialAttention"]
