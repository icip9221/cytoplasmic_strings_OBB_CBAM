pipeline:
  yolo_obb:
    experiments:
      cbam: yolo11m-obb-1cbam

    datasets:
      positive_only:
        # Required: local dataset YAML for the positive-only data_622_2 split.
        data_yaml: /path/to/data_622_2/data.yaml
        # Required: output root. The experiment name is appended automatically.
        project_root: outputs/yolo_obb/positive_only

    weights:
      # Downloaded automatically by Ultralytics if missing.
      yolo11m_obb_pretrained: yolo11m-obb.pt

    architectures:
      yolo11m_obb_cbam: configs/yolo11m-obb-1cbam.yaml
