pipeline:
  yolo_detection:
    datasets:
      hbb:
        data_yaml: /path/to/hbb_dataset/data.yaml
        project_root: outputs/yolo_detection/hbb
      obb:
        data_yaml: /path/to/obb_dataset/data.yaml
        project_root: outputs/yolo_detection/obb

    weights:
      yolo11m_hbb: yolo11m.pt
      yolo11m_obb: yolo11m-obb.pt

    architectures:
      yolo11m_obb_cbam: configs/obb/yolo11m-obb-1cbam.yaml
